{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.homeplanner.invalid/vps-v1",
  "definitions": {
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["userId", "sessionId", "displayName", "csrfToken"],
      "properties": {
        "userId": { "$ref": "#/definitions/uuid" },
        "sessionId": { "$ref": "#/definitions/uuid" },
        "displayName": { "type": "string", "maxLength": 120 },
        "csrfToken": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
      }
    },
    "uploadReservation": {
      "type": "object", "additionalProperties": false,
      "required": ["photoId", "expiresAt", "uploadUrl", "contentType", "maxBytes"],
      "properties": {
        "photoId": { "$ref": "#/definitions/uuid" },
        "expiresAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$" },
        "uploadUrl": { "type": "string", "pattern": "^/api/designs/[0-9a-f-]{36}/photos/[0-9a-f-]{36}/raw$" },
        "contentType": { "enum": ["image/jpeg", "image/png", "image/webp"] },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 10485760 }
      }
    },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
  }
}
